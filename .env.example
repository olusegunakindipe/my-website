# Email (contact form)
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-app-password
EMAIL_TO=recipient-email@example.com

# Sanity CMS (articles)
# Create a project at https://www.sanity.io/manage then paste values below.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2025-07-27

# Public site URL used for canonical links, Open Graph, sitemap, and robots
# Example: https://olusegunakindipe.com (no trailing slash)
NEXT_PUBLIC_SITE_URL=https://olusegunakindipe.com

# Shared secret for Sanity → Next.js on-demand revalidation webhook
# Generate any long random string; use the same value in Sanity webhook settings.
SANITY_REVALIDATE_SECRET=

# Optional free Gemini chat ("Ask AI" widget)
# Get a free key: https://aistudio.google.com/apikey
# Leave empty to keep the widget; API will return a friendly "not configured" message.
GEMINI_API_KEY=
# Optional model override. Prefer a current free-tier model such as:
GEMINI_MODEL=gemini-flash-lite-latest
